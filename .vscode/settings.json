{
  "haskell.formattingProvider": "fourmolu",
  "[haskell]": {
    "editor.defaultFormatter": "haskell.haskell"
  },
  "emeraldwalk.runonsave": {
    "commands": [
      {
        "cmd": "find . \\( -name '*.cabal' -o -name 'cabal.project*' -o -path './ci-configs/cabal.project' -o -path './ci-configs/*.config' \\) -exec cabal-gild --io {} \\;",
        "match": "(\\.cabal|cabal\\.project.*|ci-configs/\\.*|\\.l?hs)$",
        "isAsync": true
      }
    ]
  },
  "github-actions.workflows.pinned.workflows": [
    ".github/workflows/haskell.yml"
  ],
  "files.associations": {
    "**/ci-configs/*.config": "cabal"
  }
}
